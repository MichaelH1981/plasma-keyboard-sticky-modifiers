+std::optional<quint32> Keyboard::keycodeForKeysym(xkb_keysym_t keysym) const
+{
+    if (!mXkbKeymap) {
+        return std::nullopt;
+    }
+
+    const xkb_keysym_t lowercaseKeysym = xkb_keysym_to_lower(keysym);
+    const xkb_keycode_t minimum = xkb_keymap_min_keycode(mXkbKeymap.get());
+    const xkb_keycode_t maximum = xkb_keymap_max_keycode(mXkbKeymap.get());
+
+    for (xkb_keycode_t keycode = minimum; keycode <= maximum; ++keycode) {
+        const xkb_layout_index_t layouts = xkb_keymap_num_layouts_for_key(mXkbKeymap.get(), keycode);
+        for (xkb_layout_index_t layout = 0; layout < layouts; ++layout) {
+            const xkb_level_index_t levels = xkb_keymap_num_levels_for_key(mXkbKeymap.get(), keycode, layout);
+            for (xkb_level_index_t level = 0; level < levels; ++level) {
+                const xkb_keysym_t *keysyms = nullptr;
+                const int count = xkb_keymap_key_get_syms_by_level(mXkbKeymap.get(), keycode, layout, level, &keysyms);
+                for (int index = 0; index < count; ++index) {
+                    if (keysyms[index] == keysym || xkb_keysym_to_lower(keysyms[index]) == lowercaseKeysym) {
+                        // wl_keyboard keycodes are evdev keycodes, offset by eight from XKB keycodes.
+                        if (keycode >= 8) {
+                            return keycode - 8;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    return std::nullopt;
+}
+
+quint32 Keyboard::nativeModifiers(Qt::KeyboardModifiers modifiers) const
+{
+    if (!mXkbKeymap) {
+        return 0;
+    }
+
+    quint32 mask = 0;
+    const auto addModifier = [this, modifiers, &mask](Qt::KeyboardModifier qtModifier, const char *xkbName) {
+        if (!(modifiers & qtModifier)) {
+            return;
+        }
+        const xkb_mod_index_t index = xkb_keymap_mod_get_index(mXkbKeymap.get(), xkbName);
+        if (index != XKB_MOD_INVALID && index < 32) {
+            mask |= quint32(1) << index;
+        }
+    };
+
+    addModifier(Qt::ShiftModifier, XKB_MOD_NAME_SHIFT);
+    addModifier(Qt::ControlModifier, XKB_MOD_NAME_CTRL);
+    addModifier(Qt::AltModifier, XKB_MOD_NAME_ALT);
+    addModifier(Qt::MetaModifier, XKB_MOD_NAME_LOGO);
+    return mask;
+}
