+bool InputPlugin::modifiedKey(QKeyEvent *event, KeyState state)
+{
+    if (!m_context || !m_keyboard) {
+        return false;
+    }
+
+    const QList<xkb_keysym_t> keysyms = QXkbCommon::toKeysym(event);
+    for (const xkb_keysym_t keysym : keysyms) {
+        const auto keycode = m_keyboard->keycodeForKeysym(keysym);
+        if (!keycode) {
+            continue;
+        }
+
+        const quint32 modifiers = m_keyboard->nativeModifiers(event->modifiers());
+        if (state == Pressed) {
+            m_context->modifiers(m_context->m_lastKeyboardSerial, modifiers, 0, 0, m_keyboard->currentLayout());
+        }
+
+        key(state, *keycode);
+
+        if (state == Released) {
+            m_context->modifiers(m_context->m_lastKeyboardSerial, 0, 0, 0, m_keyboard->currentLayout());
+        }
+        return true;
+    }
+
+    return false;
+}
